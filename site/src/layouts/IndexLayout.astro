---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';

import { getSidebar } from '../utils/content';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const sidebarSections = getSidebar();

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <Navbar />
  <div class="layout-container">
    <Sidebar sections={sidebarSections} currentPath={currentPath} />
    
    <main class="content-area">
      <div class="index-header">
        <button onclick="history.length > 1 ? history.back() : (window.location.href='/')" class="back-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back
        </button>
        <h1>{title}</h1>
        {description && <p class="index-desc">{description}</p>}
      </div>
      
      <div class="index-content">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .layout-container {
    display: flex;
    min-height: 100vh;
  }

  .content-area {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding: var(--space-8) var(--space-6) var(--space-16);
    max-width: 1000px;
    margin-right: auto;
  }

  .index-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .index-header h1 {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-2);
  }

  .index-desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .content-area {
      margin-left: 0;
    }
  }
</style>
