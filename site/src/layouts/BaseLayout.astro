---
import SearchModal from '../components/SearchModal.astro';
import CarouselClient from '../components/CarouselClient.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A curated collection of coding problems, solutions, and notes.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Green-Ticks</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✅</text></svg>" />
    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" />

    <style is:global>
      @import '../styles/global.css';
      @import '../styles/typography.css';
    </style>
  </head>
  <body>
    <slot />

    <SearchModal />
    <CarouselClient />

    <script is:inline>
      // Restore theme from localStorage before paint to avoid flash
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </body>
</html>
