---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Problem } from '../utils/content';
import { getSidebar, slugify } from '../utils/content';

interface Props {
  problem: Problem;
  headings?: any[];
}

const { problem, headings = [] } = Astro.props;
const sidebarSections = getSidebar();
const currentPath = Astro.url.pathname;

// Collect all tags neatly
const hasTopics = problem.topics.length > 0;
const hasCompanies = problem.companies.length > 0 && !(problem.companies.length === 1 && problem.companies[0] === 'Not Specified');
const hasPlatforms = problem.platforms.length > 0 && !(problem.platforms.length === 1 && problem.platforms[0] === 'Miscellaneous');
const hasOtherTags = problem.otherTags.length > 0;
const hasGroups = problem.groups.length > 0;
const hasRating = problem.rating != null && problem.rating > 0;
---

<BaseLayout title={problem.title} description={`Solution for ${problem.title}`}>
  <Navbar />
  <div class="layout-container">
    <Sidebar sections={sidebarSections} currentPath={currentPath} />
    
    <main class="content-area">
      <article class="prose problem-article">
        <header class="problem-header">
          <button onclick="history.length > 1 ? history.back() : (window.location.href='/problems')" class="back-button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Back
          </button>
          <h1>{problem.title}</h1>
          
          <!-- Top metadata bar: difficulty + platform + rating + external link -->
          <div class="problem-meta-bar">
            <DifficultyBadge difficulty={problem.difficulty} size="md" />
            
            {hasPlatforms && (
              problem.platforms.map(platform => (
                <span class="chip platform-chip">{platform}</span>
              ))
            )}

            {hasRating && (
              <div class="rating" title={`Rating: ${problem.rating}/5`}>
                {'⭐'.repeat(problem.rating)}
              </div>
            )}

            {problem.link && (
              <a href={problem.link} target="_blank" rel="noopener noreferrer" class="external-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
                View on Platform
              </a>
            )}
          </div>

          <!-- Tag sections -->
          <div class="problem-tags-section">
            {hasTopics && (
              <div class="tag-row">
                <span class="tag-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                  Topics
                </span>
                <div class="tag-chips">
                  {problem.topics.map(topic => (
                    <a href={`/topics/${slugify(topic)}`} class="chip topic-chip">{topic}</a>
                  ))}
                </div>
              </div>
            )}

            {hasCompanies && (
              <div class="tag-row">
                <span class="tag-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                  Companies
                </span>
                <div class="tag-chips">
                  {problem.companies.map(company => (
                    <a href={`/companies/${slugify(company)}`} class="chip company-chip">
                      <img 
                        src={`https://img.logo.dev/${company.toLowerCase().replace(/\s+/g, '')}.com?token=pk_Rz4w6xvYTiePJGWqYM4rcw&size=20&format=png`} 
                        alt="" 
                        width="14" 
                        height="14"
                        loading="lazy"
                        onerror="this.style.display='none'"
                      />
                      {company}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {hasGroups && (
              <div class="tag-row">
                <span class="tag-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                  Groups
                </span>
                <div class="tag-chips">
                  {problem.groups.map(group => (
                    <a href={`/groups/${slugify(group)}`} class="chip group-chip">{group}</a>
                  ))}
                </div>
              </div>
            )}

            {hasOtherTags && (
              <div class="tag-row">
                <span class="tag-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                  Tags
                </span>
                <div class="tag-chips">
                  {problem.otherTags.map(tag => (
                    <a href={`/misc/${slugify(tag)}`} class="chip other-chip">{tag}</a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </header>

        <div class="markdown-content">
          <slot />
        </div>
      </article>
    </main>
    
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style>
  .layout-container {
    display: flex;
    min-height: 100vh;
    padding-top: var(--navbar-height);
  }

  .content-area {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding: var(--space-8) var(--space-6) var(--space-16);
    /* Set a reasonable max-width for the actual reading content so it doesn't span full width of an ultrawide */
    max-width: calc(100% - var(--sidebar-width) - var(--toc-width));
  }

  @media (max-width: 1200px) {
    .content-area {
      max-width: calc(100% - var(--sidebar-width));
    }
  }

  @media (max-width: 768px) {
    .content-area {
      margin-left: 0;
      max-width: 100%;
    }
  }

  .problem-article {
    margin: 0 auto;
  }

  .problem-header {
    margin-bottom: var(--space-8);
  }

  .problem-header h1 {
    margin-bottom: var(--space-4);
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Top bar: difficulty + platform + rating + external link */
  .problem-meta-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .rating {
    font-size: var(--text-sm);
    line-height: 1;
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .external-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--color-primary-bg);
  }

  /* Tag sections */
  .problem-tags-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .tag-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .tag-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    min-width: 100px;
    flex-shrink: 0;
    padding-top: 3px;
  }

  .tag-label svg {
    opacity: 0.6;
  }

  .tag-chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: all var(--transition-fast);
    line-height: 1.6;
  }

  .platform-chip {
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .topic-chip {
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border: 1px solid transparent;
  }

  .topic-chip:hover {
    border-color: var(--color-primary);
  }

  .company-chip {
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .company-chip:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg-tertiary);
  }

  .company-chip img {
    border-radius: 2px;
  }

  .group-chip {
    background: rgba(168, 85, 247, 0.1);
    color: rgb(168, 85, 247);
    border: 1px solid transparent;
  }

  .group-chip:hover {
    border-color: rgb(168, 85, 247);
  }

  .other-chip {
    background: var(--color-tag-bg, var(--color-bg-tertiary));
    color: var(--color-tag-text, var(--color-text-secondary));
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .content-area {
      margin-left: 0;
    }

    .tag-row {
      flex-direction: column;
      gap: var(--space-1);
    }

    .tag-label {
      min-width: unset;
    }
  }
</style>
