---
interface Props {
  title: string;
  href: string;
  count?: number;
  icon?: string;
  description?: string;
  logoUrl?: string;
}

const { title, href, count, icon, description, logoUrl } = Astro.props;
---

<a class="card" href={href}>
  <div class="card-header">
    {logoUrl && (
      <img
        class="card-logo"
        src={logoUrl}
        alt={title}
        width="32"
        height="32"
        loading="lazy"
        onerror="this.style.display='none'"
      />
    )}
    {icon && !logoUrl && <span class="card-icon">{icon}</span>}
    <h3 class="card-title">{title}</h3>
  </div>
  {description && <p class="card-desc">{description}</p>}
  {count != null && (
    <div class="card-footer">
      <span class="card-count">{count} {count === 1 ? 'problem' : 'problems'}</span>
    </div>
  )}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-text-primary);
    transition: all var(--transition-base);
    box-shadow: var(--shadow-card);
  }

  .card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .card-logo {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    object-fit: contain;
    flex-shrink: 0;
  }

  .card-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .card-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-normal);
    flex-grow: 1;
  }

  .card-footer {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .card-count {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-medium);
  }
</style>
