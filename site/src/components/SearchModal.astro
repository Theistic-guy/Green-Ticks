---
// Search Modal Component
// Triggered by Ctrl+K or clicking the search button in the navbar.
---

<dialog id="search-modal" class="search-modal">
  <div class="search-container">
    <header class="search-header">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.35-4.35" />
      </svg>
      <input 
        type="text" 
        id="search-input" 
        class="search-input" 
        placeholder="Search problems, topics, templates..." 
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-close" class="search-close" aria-label="Close search">
        <span class="shortcut">ESC</span>
      </button>
    </header>

    <div class="search-results" id="search-results">
      <div class="search-empty-state">
        Type to search...
      </div>
    </div>
    
    <footer class="search-footer">
      <div class="search-footer-hint">
        <span>Navigate</span> <kbd>↑</kbd> <kbd>↓</kbd>
      </div>
      <div class="search-footer-hint">
        <span>Open</span> <kbd>Enter</kbd>
      </div>
    </footer>
  </div>
</dialog>

<!-- Load Fuse.js from CDN for client-side search -->
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js" is:inline></script>

<style>
  .search-modal {
    padding: 0;
    margin: auto;
    width: 100%;
    max-width: 600px;
    background: transparent;
    border: none;
    backdrop-filter: blur(4px);
    overflow: visible;
  }

  .search-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .search-container {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    overflow: hidden;
  }

  .search-header {
    display: flex;
    align-items: center;
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .search-icon {
    color: var(--color-text-secondary);
    margin-right: var(--space-3);
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    padding: var(--space-4) 0;
    font-size: var(--text-base);
    color: var(--color-text-primary);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .search-close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    color: var(--color-text-tertiary);
  }

  .shortcut {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    background: var(--color-bg-tertiary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .search-results {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-2);
    min-height: 100px;
  }

  .search-empty-state {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }

  /* Global result styles used by JS */
  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text-primary);
    border-left: 2px solid transparent;
  }

  :global(.search-result-item[aria-selected="true"]),
  :global(.search-result-item:hover) {
    background: var(--color-bg-secondary);
    border-left-color: var(--color-primary);
  }

  :global(.search-result-title) {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-1);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  :global(.search-result-type) {
    font-size: 10px;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
  }
  
  :global(.search-result-type.Problem) {
    color: var(--color-primary);
    background: var(--color-primary-bg);
  }

  :global(.search-result-tags) {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .search-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .search-footer-hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  kbd {
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 4px;
    font-family: var(--font-mono);
    box-shadow: 0 1px 1px rgba(0,0,0,0.1);
  }
</style>

<script is:inline>
  (function() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const closeBtn = document.getElementById('search-close');
    const triggerBtn = document.getElementById('search-trigger'); // in Navbar

    let fuse = null;
    let indexLoaded = false;
    let selectedIndex = -1;
    let currentResults = [];

    async function loadIndex() {
      if (indexLoaded) return;
      try {
        const res = await fetch('/search.json');
        const data = await res.json();
        // @ts-ignore - Fuse is loaded via CDN above
        fuse = new Fuse(data, {
          keys: [
            { name: 'title', weight: 2 },
            { name: 'tags', weight: 1 }
          ],
          threshold: 0.3,
          includeMatches: true
        });
        indexLoaded = true;
      } catch (err) {
        console.error('Failed to load search index', err);
        resultsContainer.innerHTML = '<div class="search-empty-state">Failed to load search index.</div>';
      }
    }

    function openModal() {
      modal.showModal();
      document.body.style.overflow = 'hidden';
      input.value = '';
      resultsContainer.innerHTML = '<div class="search-empty-state">Type to search...</div>';
      input.focus();
      loadIndex();
    }

    function closeModal() {
      modal.close();
      document.body.style.overflow = '';
    }

    function renderResults(results) {
      if (results.length === 0) {
        resultsContainer.innerHTML = '<div class="search-empty-state">No results found.</div>';
        currentResults = [];
        return;
      }

      currentResults = results.slice(0, 15); // Limit to top 15
      selectedIndex = 0; // auto-select first

      const html = currentResults.map((result, i) => {
        const item = result.item;
        return `
          <a href="${item.url}" class="search-result-item" id="result-item-${i}" aria-selected="${i === 0}">
            <div class="search-result-title">
              <span class="search-result-type ${item.type}">${item.type}</span>
              ${item.title}
            </div>
            ${item.tags && item.tags.length > 0 ? `
              <div class="search-result-tags">
                ${item.tags.slice(0, 4).join(' • ')}${item.tags.length > 4 ? '...' : ''}
              </div>
            ` : ''}
          </a>
        `;
      }).join('');

      resultsContainer.innerHTML = html;
    }

    function updateSelection() {
      const items = resultsContainer.querySelectorAll('.search-result-item');
      items.forEach((el, i) => {
        if (i === selectedIndex) {
          el.setAttribute('aria-selected', 'true');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.setAttribute('aria-selected', 'false');
        }
      });
    }

    // Event Listeners
    if (triggerBtn) {
      triggerBtn.addEventListener('click', openModal);
    }
    
    closeBtn.addEventListener('click', closeModal);
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(); // click outside
    });

    document.addEventListener('keydown', (e) => {
      // Ctrl+K to open
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        openModal();
      }
      
      // Close on Escape is handled natively by <dialog>, but let's make sure body overflow resets
      if (e.key === 'Escape' && modal.open) {
        closeModal();
      }
    });

    input.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      if (!query) {
        resultsContainer.innerHTML = '<div class="search-empty-state">Type to search...</div>';
        currentResults = [];
        return;
      }

      if (fuse) {
        const results = fuse.search(query);
        renderResults(results);
      }
    });

    input.addEventListener('keydown', (e) => {
      if (currentResults.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % currentResults.length;
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + currentResults.length) % currentResults.length;
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (selectedIndex >= 0 && selectedIndex < currentResults.length) {
          window.location.href = currentResults[selectedIndex].item.url;
        }
      }
    });

    // Hover to select
    resultsContainer.addEventListener('mouseover', (e) => {
      const item = e.target.closest('.search-result-item');
      if (item) {
        const id = item.id.replace('result-item-', '');
        selectedIndex = parseInt(id, 10);
        updateSelection();
      }
    });

  })();
</script>
