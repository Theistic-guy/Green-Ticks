---
interface Props {
  difficulty: string;
  size?: 'sm' | 'md';
}

const { difficulty, size = 'sm' } = Astro.props;

const colorMap: Record<string, string> = {
  'Easy': 'easy',
  'Medium': 'medium',
  'Hard': 'hard',
};

const variant = colorMap[difficulty] || 'default';
---

<span class={`badge badge-${variant} badge-${size}`}>{difficulty}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .badge-sm {
    font-size: var(--text-xs);
    padding: 2px 10px;
  }

  .badge-md {
    font-size: var(--text-sm);
    padding: 4px 14px;
  }

  .badge-easy {
    color: var(--color-easy);
    background: var(--color-easy-bg);
  }

  .badge-medium {
    color: var(--color-medium);
    background: var(--color-medium-bg);
  }

  .badge-hard {
    color: var(--color-hard);
    background: var(--color-hard-bg);
  }

  .badge-default {
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
  }
</style>
