---
interface Props {
  currentUrl: string;
}

const { currentUrl } = Astro.props;
---

<div id="graph-sidebar-container" data-current-url={currentUrl}>
  <div id="graph-overlay" class="overlay-hidden">
    <div class="overlay-header">
      <div class="header-left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="5" cy="18" r="3"></circle>
          <circle cx="19" cy="18" r="3"></circle>
          <circle cx="12" cy="6" r="3"></circle>
          <path d="M10 8l-3 8"></path>
          <path d="M14 8l3 8"></path>
          <path d="M7 18h10"></path>
        </svg>
        <h3>Local Graph View</h3>
      </div>
      <button id="graph-close-btn" aria-label="Close Graph">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div id="graph-viewport"></div>
    <button id="graph-recenter-btn" aria-label="Recenter Graph" title="Recenter Graph">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <line x1="12" y1="2" x2="12" y2="6"></line>
        <line x1="12" y1="18" x2="12" y2="22"></line>
        <line x1="4" y1="12" x2="8" y2="12"></line>
        <line x1="16" y1="12" x2="20" y2="12"></line>
      </svg>
    </button>
  </div>
</div>

<style>
  #graph-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.85); /* Translucent dark slate */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  /* Make sure it works perfectly in light mode too (dark overlay is usually fine, but we can adapt) */
  :root[data-theme="light"] #graph-overlay {
    background: rgba(255, 255, 255, 0.9);
  }

  .overlay-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .overlay-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .overlay-header {
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1010;
    pointer-events: none; /* Let clicks pass through header empty space */
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    pointer-events: auto;
  }

  .header-left h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-1);
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  :root[data-theme="light"] .header-left h3 {
    text-shadow: 0 1px 2px rgba(255,255,255,0.8);
  }

  #graph-close-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--text-1);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    pointer-events: auto;
    backdrop-filter: blur(4px);
  }

  :root[data-theme="light"] #graph-close-btn {
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  #graph-close-btn:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: scale(1.05);
  }

  #graph-viewport {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #graph-recenter-btn {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: var(--text-1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1010;
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }

  :root[data-theme="light"] #graph-recenter-btn {
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  #graph-recenter-btn:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: scale(1.05);
  }
</style>

<script>
  let ForceGraph;
  let graphInstance = null;
  let graphDataCache = null;

  const container = document.getElementById('graph-sidebar-container');
  const overlay = document.getElementById('graph-overlay');
  const closeBtn = document.getElementById('graph-close-btn');
  const viewport = document.getElementById('graph-viewport');
  const recenterBtn = document.getElementById('graph-recenter-btn');

  let rawUrl = container.dataset.currentUrl;
  if (!rawUrl.startsWith('/')) rawUrl = '/' + rawUrl;
  if (rawUrl.length > 1 && rawUrl.endsWith('/')) rawUrl = rawUrl.slice(0, -1);
  if (rawUrl.endsWith('/index.html')) {
    rawUrl = rawUrl.slice(0, -11);
    if (rawUrl === '') rawUrl = '/';
  }
  const currentUrl = rawUrl;

  async function openGraph() {
    overlay.classList.remove('overlay-hidden');
    overlay.classList.add('overlay-visible');
    
    // Prevent background scrolling
    document.body.style.overflow = 'hidden';

    if (!ForceGraph) {
      const module = await import('force-graph');
      ForceGraph = module.default;
    }

    if (!graphDataCache) {
      try {
        const res = await fetch('/graph-data.json');
        graphDataCache = await res.json();
      } catch (err) {
        console.error('Failed to load graph data:', err);
        return;
      }
    }

    renderGraph();
  }

  function closeGraph() {
    overlay.classList.add('overlay-hidden');
    overlay.classList.remove('overlay-visible');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeGraph);
  recenterBtn.addEventListener('click', () => {
    if (graphInstance) graphInstance.zoomToFit(400, 50);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('overlay-visible')) {
      closeGraph();
    }
  });

  // Expose openGraph globally so layout buttons can trigger it
  window.openLocalGraph = openGraph;

  // Attach event listeners to the buttons rendered in NoteLayout and ProblemLayout
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.graph-toggle-btn');
    toggleBtns.forEach(btn => {
      btn.addEventListener('click', openGraph);
    });
  });

  function renderGraph() {
    const allNodes = graphDataCache.nodes;
    const allLinks = graphDataCache.links;

    const neighborhoodLinks = allLinks.filter(l => 
      l.source === currentUrl || l.target === currentUrl ||
      l.source.id === currentUrl || l.target.id === currentUrl
    );

    const neighborhoodNodeIds = new Set();
    neighborhoodNodeIds.add(currentUrl);
    
    neighborhoodLinks.forEach(l => {
      neighborhoodNodeIds.add(typeof l.source === 'object' ? l.source.id : l.source);
      neighborhoodNodeIds.add(typeof l.target === 'object' ? l.target.id : l.target);
    });

    const neighborhoodNodes = allNodes.filter(n => neighborhoodNodeIds.has(n.id));

    const colorMap = {
      problems: '#f87171',
      notes: '#60a5fa',
      templates: '#34d399',
      'write-ups': '#c084fc',
      topics: '#fbbf24',
      default: '#9ca3af'
    };

    if (!graphInstance) {
      graphInstance = ForceGraph()(viewport)
        .backgroundColor('transparent')
        .width(viewport.clientWidth)
        .height(viewport.clientHeight)
        .nodeRelSize(6)
        .linkColor(() => {
           const isLight = document.documentElement.getAttribute('data-theme') === 'light';
           return isLight ? 'rgba(0,0,0,0.15)' : 'rgba(255,255,255,0.15)';
        })
        .linkDirectionalParticles(2)
        .linkDirectionalParticleSpeed(0.005)
        .minZoom(0.5)
        .maxZoom(8)
        .nodeCanvasObject((node, ctx, globalScale) => {
          const isCenter = node.id === currentUrl;
          const isLight = document.documentElement.getAttribute('data-theme') === 'light';
          
          // Draw Node Circle
          const size = isCenter ? 12 : 5; // Center node is much larger
          ctx.beginPath();
          ctx.arc(node.x, node.y, size, 0, 2 * Math.PI, false);
          ctx.fillStyle = isCenter 
            ? (isLight ? '#000000' : '#ffffff') 
            : (colorMap[node.group] || colorMap.default);
          ctx.fill();

          // Draw Text Label
          // Show text for center node always, and for other nodes only if zoomed in (globalScale > 1.2)
          if (isCenter || globalScale > 1.2) {
            const label = node.title;
            const fontSize = isCenter ? 14 / globalScale : 12 / globalScale;
            ctx.font = `${fontSize}px Sans-Serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            ctx.fillStyle = isLight ? '#1f2937' : 'rgba(255, 255, 255, 0.8)';
            ctx.fillText(label, node.x, node.y + size + (2 / globalScale));
          }
        })
        .onNodeClick(node => {
          window.location.href = node.url;
        })
        .onNodeHover(node => {
          viewport.style.cursor = node ? 'pointer' : null;
        });

      // Use ResizeObserver for perfect viewport tracking
      const ro = new ResizeObserver(entries => {
        if (!graphInstance || !overlay.classList.contains('overlay-visible')) return;
        for (let entry of entries) {
          graphInstance.width(entry.contentRect.width).height(entry.contentRect.height);
        }
      });
      ro.observe(viewport);
    } else {
      // If re-rendering, ensure size matches
      graphInstance.width(viewport.clientWidth).height(viewport.clientHeight);
    }

    const gData = {
      nodes: neighborhoodNodes.map(n => ({ ...n })),
      links: neighborhoodLinks.map(l => ({ ...l }))
    };

    graphInstance.graphData(gData);
    
    // Adjust physics to spread out 100+ nodes effectively
    graphInstance.d3Force('charge').strength(-200);
    graphInstance.d3Force('link').distance(60);

    // Auto-center the graph after a short delay to allow physics to settle
    setTimeout(() => {
      if (graphInstance && overlay.classList.contains('overlay-visible')) {
        graphInstance.zoomToFit(400, 50); // 400ms transition, 50px padding
      }
    }, 400);
  }
</script>
