<script>
class GreenCarousel extends HTMLElement {
  connectedCallback() {
    this.track = this.querySelector('.carousel-track');
    this.displayCount = parseInt(this.dataset.display || '1', 10);
    this.rotation = this.dataset.rotation === 'true';
    this.speed = parseInt(this.dataset.speed || '3000', 10);
    
    // Set custom property for CSS
    this.style.setProperty('--display-count', this.displayCount.toString());
    
    // Add prev/next buttons if more than 1 card
    const wrapper = this.querySelector('.carousel-wrapper');
    if (wrapper && this.track && this.track.children.length > 1) {
      if (!this.querySelector('.carousel-btn-prev')) {
        const prevBtn = document.createElement('button');
        prevBtn.className = 'carousel-btn carousel-btn-prev';
        prevBtn.setAttribute('aria-label', 'Previous slide');
        prevBtn.innerHTML = '‹';
        prevBtn.addEventListener('click', () => {
          this.scrollDelta(-1);
          this.stopRotation();
        });
        wrapper.appendChild(prevBtn);

        const nextBtn = document.createElement('button');
        nextBtn.className = 'carousel-btn carousel-btn-next';
        nextBtn.setAttribute('aria-label', 'Next slide');
        nextBtn.innerHTML = '›';
        nextBtn.addEventListener('click', () => {
          this.scrollDelta(1);
          this.stopRotation();
        });
        wrapper.appendChild(nextBtn);
      }
    }
    
    if (this.rotation && this.track && this.track.children.length > this.displayCount) {
      this.startRotation();
      
      // Pause on hover
      this.addEventListener('mouseenter', () => this.stopRotation());
      this.addEventListener('mouseleave', () => this.startRotation());
    }
  }
  
  disconnectedCallback() {
    this.stopRotation();
  }

  scrollDelta(dir) {
    if (!this.track || !this.track.firstElementChild) return;
    const cardWidth = this.track.firstElementChild.getBoundingClientRect().width;
    const gap = 16;
    const scrollAmount = (cardWidth + gap) * dir;
    this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  }
  
  startRotation() {
    if (this.interval) return;
    this.interval = setInterval(() => {
      if (!this.track || !this.track.firstElementChild) return;
      const cardWidth = this.track.firstElementChild.getBoundingClientRect().width;
      const gap = 16;
      const scrollAmount = cardWidth + gap;
      
      // If we've reached the end, snap back to start
      if (this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 10) {
        this.track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    }, this.speed);
  }
  
  stopRotation() {
    if (this.interval) {
      clearInterval(this.interval);
      this.interval = null;
    }
  }
}

customElements.define('green-carousel', GreenCarousel);
</script>

<style is:global>
