<script>
class GreenCarousel extends HTMLElement {
  connectedCallback() {
    this.track = this.querySelector('.carousel-track');
    this.displayCount = parseInt(this.dataset.display || '1', 10);
    this.rotation = this.dataset.rotation === 'true';
    this.speed = parseInt(this.dataset.speed || '3000', 10);
    
    // Set custom property for CSS
    this.style.setProperty('--display-count', this.displayCount.toString());
    
    if (this.rotation && this.track && this.track.children.length > this.displayCount) {
      this.startRotation();
      
      // Pause on hover
      this.addEventListener('mouseenter', () => this.stopRotation());
      this.addEventListener('mouseleave', () => this.startRotation());
    }
  }
  
  disconnectedCallback() {
    this.stopRotation();
  }
  
  startRotation() {
    if (this.interval) return;
    this.interval = setInterval(() => {
      if (!this.track) return;
      const cardWidth = this.track.firstElementChild.getBoundingClientRect().width;
      const gap = 16; // 1rem gap
      const scrollAmount = cardWidth + gap;
      
      // If we've reached the end, snap back to start
      if (this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 10) {
        this.track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    }, this.speed);
  }
  
  stopRotation() {
    if (this.interval) {
      clearInterval(this.interval);
      this.interval = null;
    }
  }
}

customElements.define('green-carousel', GreenCarousel);
</script>

<style is:global>
green-carousel {
  display: block;
  width: 100%;
  margin: 2.5rem 0;
  position: relative;
  --display-count: 1;
}

.carousel-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.carousel-track {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none;  /* IE and Edge */
  padding-bottom: 0.5rem; /* Room for shadows */
}

.carousel-track::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}

.carousel-card {
  /* Calculate width based on display count, subtracting the gap share */
  flex: 0 0 calc((100% - (1rem * (var(--display-count) - 1))) / var(--display-count));
  scroll-snap-align: start;
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.carousel-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary);
}

.carousel-card-img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-bottom: 1px solid var(--border);
}

.carousel-card-content {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  gap: 0.75rem;
}

.carousel-card-content h3 {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.3;
}

.carousel-card-content p {
  margin: 0;
  color: var(--text-2);
  font-size: 0.95rem;
  line-height: 1.5;
  flex-grow: 1;
}

.carousel-card-link {
  display: inline-flex;
  align-items: center;
  margin-top: auto;
  padding: 0.5rem 1rem;
  background: var(--surface-2);
  color: var(--primary);
  font-weight: 500;
  font-size: 0.9rem;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
  align-self: flex-start;
  border: 1px solid var(--border);
}

.carousel-card-link:hover {
  background: var(--primary);
  color: white;
}

.carousel-caption {
  text-align: center;
  font-size: 0.9rem;
  color: var(--text-3);
  font-style: italic;
  margin-top: 0.5rem;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  green-carousel {
    /* On mobile, force display count to 1 for readability, or let user decide? */
    /* Let's force it to 1.something so next card peeks out slightly */
    --display-count: 1.15 !important;
  }
}
</style>
