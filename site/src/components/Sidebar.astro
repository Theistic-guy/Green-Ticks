---
/**
 * Collapsible sidebar navigation with folder tree.
 * Section headings are visually distinct with collapsible chevrons.
 */
interface SidebarItem {
  label: string;
  href?: string;
  children?: SidebarItem[];
  count?: number;
  icon?: string;
}

interface Props {
  sections: SidebarItem[];
  currentPath?: string;
}

const { sections, currentPath = '' } = Astro.props;

function isActive(href: string | undefined, current: string): boolean {
  if (!href) return false;
  return current === href || current.startsWith(href + '/');
}
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-inner">
    {sections.map((section) => (
      <div class="sidebar-section">
        <details class="section-details" open>
          <summary class="section-heading">
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
            <span class="section-label">{section.label}</span>
            {section.href && (
              <a href={section.href} class="section-goto" title={`Go to ${section.label}`}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
              </a>
            )}
          </summary>

          {section.children && section.children.length > 0 && (
            <ul class="sidebar-list">
              {section.children.map((item) => (
                <li class="sidebar-item">
                  {item.children && item.children.length > 0 ? (
                    <details open={isActive(item.href, currentPath)}>
                      <summary class={`sidebar-folder ${isActive(item.href, currentPath) ? 'active' : ''}`}>
                        <svg class="folder-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                        <svg class="folder-icon icon-folder-closed" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        <svg class="folder-icon icon-folder-open" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
                        {item.href ? (
                          <a href={item.href}>{item.label}</a>
                        ) : (
                          <span>{item.label}</span>
                        )}
                        {item.count != null && <span class="sidebar-count">{item.count}</span>}
                      </summary>
                      <ul class="sidebar-list nested">
                        {item.children.map((child) => (
                          <li class="sidebar-item">
                            <a
                              class={`sidebar-link ${currentPath === child.href ? 'active' : ''} ${child.label === 'Overview' ? 'overview-link' : ''}`}
                              href={child.href}
                            >
                              {child.label === 'Overview' ? '🌟 ' + child.label : child.label}
                              {child.count != null && <span class="sidebar-count">{child.count}</span>}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a
                      class={`sidebar-link ${currentPath === item.href ? 'active' : ''} ${item.label === 'Overview' ? 'overview-link' : ''}`}
                      href={item.href}
                    >
                      {item.label === 'Overview' ? '🌟 ' + item.label : item.label}
                      {item.count != null && <span class="sidebar-count">{item.count}</span>}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </details>
      </div>
    ))}
  </div>
</aside>

<!-- Overlay for mobile -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<style>
  .sidebar {
    position: fixed;
    top: var(--navbar-height);
    left: 0;
    bottom: 0;
    width: var(--sidebar-width);
    background: var(--color-bg-sidebar);
    border-right: 1px solid var(--color-border);
    overflow-y: auto;
    z-index: var(--z-sidebar);
    transition: transform var(--transition-slow);
  }

  .sidebar-inner {
    padding: var(--space-3) 0;
  }

  /* === Section headings === */
  .sidebar-section {
    margin-bottom: var(--space-1);
  }

  .section-details {
    /* Remove native marker */
  }

  .section-details > summary {
    list-style: none;
  }
  .section-details > summary::-webkit-details-marker {
    display: none;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    margin: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    cursor: pointer;
    user-select: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    position: relative;
  }

  .section-heading::before {
    content: '';
    position: absolute;
    left: -var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    height: 60%;
    width: 3px;
    background: var(--color-primary);
    border-radius: 0 4px 4px 0;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .section-details[open] > .section-heading::before {
    opacity: 1;
  }

  .section-heading:hover {
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
  }

  .section-chevron {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
    opacity: 0.8;
    margin-left: var(--space-2);
  }

  .section-details[open] > .section-heading .section-chevron {
    transform: rotate(90deg);
  }

  .section-label {
    flex: 1;
  }

  .section-goto {
    opacity: 0;
    color: var(--color-text-tertiary);
    padding: 2px;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .section-heading:hover .section-goto {
    opacity: 1;
  }

  .section-goto:hover {
    color: var(--color-primary);
  }

  /* === List items === */
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0 var(--space-5);
    border-left: 1px solid var(--color-border-subtle, var(--color-border));
  }

  .sidebar-list.nested {
    margin-left: var(--space-6);
  }

  .sidebar-item {
    margin: 0;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) var(--space-4) var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 0;
    transition: all var(--transition-fast);
    border-left: 2px solid transparent;
    margin-left: -1px; /* Overlap the ul border */
  }

  .overview-link {
    color: var(--color-primary);
    font-weight: var(--font-weight-bold);
    background: var(--color-primary-bg);
    border-radius: var(--radius-md);
    margin: var(--space-1) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .overview-link:hover {
    transform: translateX(2px);
  }

  .sidebar-link:hover:not(.overview-link) {
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
  }

  .sidebar-link.active:not(.overview-link) {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    background: var(--color-primary-bg);
    font-weight: var(--font-weight-medium);
  }

  /* === Folder items (with nested children) === */
  .sidebar-folder {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .sidebar-folder::-webkit-details-marker {
    display: none;
  }

  .sidebar-folder:hover {
    color: var(--color-text-primary);
  }

  .sidebar-folder a {
    color: inherit;
    text-decoration: none;
  }

  .sidebar-folder a:hover {
    color: var(--color-primary);
  }

  .folder-arrow {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
    opacity: 0.5;
  }

  details[open] > summary .folder-arrow {
    transform: rotate(90deg);
  }

  .sidebar-folder .icon-folder-open { display: none; }
  .sidebar-folder .icon-folder-closed { display: inline-block; }
  
  details[open] > summary.sidebar-folder .icon-folder-open { display: inline-block; }
  details[open] > summary.sidebar-folder .icon-folder-closed { display: none; }

  .sidebar-count {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    background: var(--color-bg-secondary);
    padding: 1px 6px;
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-medium);
  }

  /* Overlay for mobile */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--color-bg-overlay);
    z-index: calc(var(--z-sidebar) - 1);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar.open + .sidebar-overlay {
      display: block;
    }
  }
</style>

<script is:inline>
  // Sidebar toggle for mobile
  const toggle = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');

  function closeSidebar() {
    sidebar?.classList.remove('open');
  }

  toggle?.addEventListener('click', () => {
    sidebar?.classList.toggle('open');
  });

  overlay?.addEventListener('click', closeSidebar);

  // Preserve scroll and collapse state
  const SCROLL_KEY = 'sidebar-scroll';
  const COLLAPSE_KEY = 'sidebar-collapse';
  
  // Restore scroll and collapse state synchronously to prevent FOUC
  (function restoreSidebarState() {
    if (sidebar) {
      // 1. Restore collapse state immediately before paint
      const storedCollapse = sessionStorage.getItem(COLLAPSE_KEY);
      if (storedCollapse) {
        try {
          const collapseState = JSON.parse(storedCollapse);
          const detailsElements = sidebar.querySelectorAll('details');
          detailsElements.forEach((details, index) => {
            const labelEl = details.querySelector('.section-label, .sidebar-folder');
            const key = labelEl ? `${index}-${labelEl.textContent.trim()}` : `${index}`;
            if (collapseState[key] !== undefined) {
              if (collapseState[key]) {
                details.setAttribute('open', '');
              } else {
                details.removeAttribute('open');
              }
            }
          });
        } catch (e) {
          console.error("Error restoring sidebar state", e);
        }
      }

      // 2. Restore scroll immediately
      const storedScroll = sessionStorage.getItem(SCROLL_KEY);
      if (storedScroll) {
        sidebar.scrollTop = parseInt(storedScroll, 10);
      } else {
        const activeItem = sidebar.querySelector('.active');
        if (activeItem) {
          // scrollIntoView works better if we wait for layout
          setTimeout(() => activeItem.scrollIntoView({ block: 'center' }), 0);
        }
      }

      // 3. Listen for toggle events to save state
      sidebar.addEventListener('toggle', (e) => {
        if (e.target.tagName === 'DETAILS') {
          const detailsElements = Array.from(sidebar.querySelectorAll('details'));
          const state = {};
          detailsElements.forEach((details, index) => {
            const labelEl = details.querySelector('.section-label, .sidebar-folder');
            const key = labelEl ? `${index}-${labelEl.textContent.trim()}` : `${index}`;
            state[key] = details.hasAttribute('open');
          });
          sessionStorage.setItem(COLLAPSE_KEY, JSON.stringify(state));
        }
      }, true); // use capture phase because toggle doesn't bubble
    }
  })();

  // Save scroll on any link click
  sidebar?.addEventListener('click', (e) => {
    const target = e.target;
    if (target.tagName === 'A' || target.closest('a')) {
      sessionStorage.setItem(SCROLL_KEY, sidebar.scrollTop.toString());
    }
  });
</script>
