---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../../layouts/NoteLayout.astro';
import { slugify } from '../../utils/content';

export async function getStaticPaths() {
  const writeUps = await getCollection('write-ups');
  return writeUps.map(entry => {
    // entry.id might contain slashes if in subdirectories
    const parts = entry.id.split('/');
    const slug = parts.map(slugify).join('/');
    
    return {
      params: { slug },
      props: { entry, parts },
    };
  });
}

const { entry, parts } = Astro.props;
const { Content, headings } = await render(entry);

// Extract title from frontmatter or filename
const fileName = parts[parts.length - 1];
const title = entry.data?.Title || fileName.replace(/-/g, ' ');
const updated = entry.data?.updated ? String(entry.data.updated) : undefined;
---

<NoteLayout title={title} pathSegments={parts} headings={headings} updated={updated}>
  <Content />
</NoteLayout>
