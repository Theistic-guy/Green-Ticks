---
import IndexLayout from '../../layouts/IndexLayout.astro';
import Card from '../../components/Card.astro';
import ListSearch from '../../components/ListSearch.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/content';

const writeUps = await getCollection('write-ups');

// Structure them nicely for the grid
const writeUpItems = writeUps.map(writeUp => {
  const parts = writeUp.id.split('/');
  const slug = parts.map(slugify).join('/');
  const title = writeUp.data.Title || parts[parts.length - 1];
  const folder = parts.length > 1 ? parts[0] : '';
  
  return { title, slug, folder };
}).sort((a, b) => a.title.localeCompare(b.title));
---

<IndexLayout title="Write-Ups" description="Blog posts and thoughts.">
  <ListSearch placeholder="Search write-ups..." />
  <div class="card-grid">
    {writeUpItems.map(item => (
      <Card 
        title={item.title} 
        href={`/write-ups/${item.slug}`} 
        icon="✍️"
        description={item.folder}
      />
    ))}
  </div>
</IndexLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-4);
  }
</style>
