---
import IndexLayout from '../../layouts/IndexLayout.astro';
import Card from '../../components/Card.astro';
import { loadProblems, groupByField, slugify } from '../../utils/content';

const problems = loadProblems();
const byTopic = groupByField(problems, 'topics');

const topics = Object.entries(byTopic)
  .map(([name, items]) => ({
    name,
    slug: slugify(name),
    count: items.length
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<IndexLayout title="Topics" description="Browse coding problems by algorithm and data structure.">
  <div class="card-grid">
    {topics.map(topic => (
      <Card 
        title={topic.name} 
        href={`/topics/${topic.slug}`} 
        count={topic.count}
        icon="🧠"
      />
    ))}
  </div>
</IndexLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-4);
  }
</style>
