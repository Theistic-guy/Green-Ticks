---
import IndexLayout from '../../layouts/IndexLayout.astro';
import Card from '../../components/Card.astro';
import { loadProblems, groupByField, slugify } from '../../utils/content';

const problems = loadProblems();
const byTag = groupByField(problems, 'otherTags');

const tags = Object.entries(byTag)
  .map(([name, items]) => ({
    name,
    slug: slugify(name),
    count: items.length
  }))
  .sort((a, b) => b.count - a.count); // Most used first
---

<IndexLayout title="Misc Tags" description="Browse coding problems by miscellaneous tags and patterns.">
  <div class="card-grid">
    {tags.map(tag => (
      <Card 
        title={tag.name} 
        href={`/misc/${tag.slug}`} 
        count={tag.count}
        icon="🏷️"
      />
    ))}
  </div>
</IndexLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-4);
  }
</style>
