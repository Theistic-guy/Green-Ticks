---
import IndexLayout from '../../layouts/IndexLayout.astro';
import Card from '../../components/Card.astro';
import { loadProblems, groupByField, slugify, sortDifficulty } from '../../utils/content';

export async function getStaticPaths() {
  const problems = loadProblems();
  const byTag = groupByField(problems, 'otherTags');
  
  return Object.entries(byTag).map(([tag, items]) => {
    const sortedItems = [...items].sort((a, b) => sortDifficulty(a.difficulty, b.difficulty));
    return {
      params: { slug: slugify(tag) },
      props: { tag, problems: sortedItems },
    };
  });
}

const { tag, problems } = Astro.props;
---

<IndexLayout title={tag} description={`${problems.length} problems tagged with ${tag}.`}>
  <div class="card-grid">
    {problems.map(p => (
      <Card 
        title={p.title} 
        href={`/problems/${p.slug}`} 
        description={`${p.difficulty} • ${p.topics.slice(0, 3).join(', ')}${p.topics.length > 3 ? '...' : ''}`} 
      />
    ))}
  </div>
</IndexLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>
