---
import IndexLayout from '../../layouts/IndexLayout.astro';
import Card from '../../components/Card.astro';
import ListSearch from '../../components/ListSearch.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/content';

const templates = await getCollection('templates');

const templateItems = templates.map(temp => {
  const parts = temp.id.split('/');
  const slug = parts.map(slugify).join('/');
  // In Astro v5 with loaders, `id` might be slugified/extensionless.
  // We use filePath to get the exact original filename if available.
  let rawFileName = temp.id;
  if (temp.filePath) {
    const segments = temp.filePath.split(/[/\\]/);
    rawFileName = segments[segments.length - 1].replace(/\.md$/, '');
  } else {
    rawFileName = parts[parts.length - 1].replace(/\.md$/, '');
  }
  
  const title = temp.data.Title || rawFileName;
  
  return { title, slug };
}).sort((a, b) => a.title.localeCompare(b.title));
---

<IndexLayout title="Templates" description="Reusable algorithm templates and patterns.">
  <ListSearch placeholder="Search templates..." />
  <div class="card-grid">
    {templateItems.map(item => (
      <Card 
        title={item.title} 
        href={`/templates/${item.slug}`} 
        icon="📄"
      />
    ))}
  </div>
</IndexLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-4);
  }
</style>
