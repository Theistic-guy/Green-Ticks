---
import IndexLayout from '../../layouts/IndexLayout.astro';
import ProblemGroupList from '../../components/ProblemGroupList.astro';
import FilterBar from '../../components/FilterBar.astro';
import type { FilterData } from '../../components/FilterBar.astro';
import { loadProblems, loadCompanyLogos, groupByField, slugify, sortDifficulty, computeFacets, loadSectionContent } from '../../utils/content';

export async function getStaticPaths() {
  const problems = loadProblems();
  const byGroup = groupByField(problems, 'groups');
  
  const LOGO_DEV_TOKEN = 'pk_cwa5LeR3RiifmBSonSReKw';
  const companyLogos = loadCompanyLogos(LOGO_DEV_TOKEN);
  
  return Object.entries(byGroup).map(([group, items]) => {
    const sortedItems = [...items].sort((a, b) => sortDifficulty(a.difficulty, b.difficulty));
    const slug = slugify(group);
    
    // Build filter data
    const filterData: FilterData = {
      baseDimension: { type: 'groups', value: group },
      problems: sortedItems.map(p => ({
        slug: p.slug,
        title: p.title,
        difficulty: p.difficulty,
        topics: p.topics,
        companies: p.companies,
        otherTags: p.otherTags,
        groups: p.groups
      })),
      facets: computeFacets(sortedItems, group),
      companyLogos
    };

    const topContent = loadSectionContent('Groups', slug, 'Top');
    const bottomContent = loadSectionContent('Groups', slug, 'Bottom');

    return {
      params: { slug },
      props: { group, problems: sortedItems, filterData, topContent, bottomContent },
    };
  });
}

const { group, problems, filterData, topContent, bottomContent } = Astro.props;
---

<IndexLayout title={group} description={`${problems.length} problems in group "${group}".`}>
  {topContent && (
    <div class="custom-section-container top-section">
      <div class="prose" set:html={topContent} />
    </div>
  )}

  <FilterBar data={filterData} />
  <ProblemGroupList problems={problems} showCompany={true} />

  {bottomContent && (
    <div class="custom-section-container bottom-section">
      <div class="prose" set:html={bottomContent} />
    </div>
  )}
</IndexLayout>

<style>
  .custom-section-container {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .custom-section-container.top-section {
    margin-bottom: var(--space-8);
  }

  .custom-section-container.bottom-section {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .custom-section-container :global(.prose > *:first-child) { margin-top: 0; }
  .custom-section-container :global(.prose > *:last-child) { margin-bottom: 0; }
</style>
