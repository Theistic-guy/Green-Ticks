---
import IndexLayout from '../../layouts/IndexLayout.astro';
import ProblemGroupList from '../../components/ProblemGroupList.astro';
import FilterBar from '../../components/FilterBar.astro';
import type { FilterData } from '../../components/FilterBar.astro';
import { loadProblems, loadCompanyLogos, groupByField, slugify, sortDifficulty, computeFacets } from '../../utils/content';

export async function getStaticPaths() {
  const problems = loadProblems();
  const byCompany = groupByField(problems, 'companies');
  
  const LOGO_DEV_TOKEN = 'pk_cwa5LeR3RiifmBSonSReKw';
  const companyLogos = loadCompanyLogos(LOGO_DEV_TOKEN);
  
  return Object.entries(byCompany).map(([company, items]) => {
    const sortedItems = [...items].sort((a, b) => sortDifficulty(a.difficulty, b.difficulty));
    
    // Build filter data
    const filterData: FilterData = {
      baseDimension: { type: 'companies', value: company },
      problems: sortedItems.map(p => ({
        slug: p.slug,
        title: p.title,
        difficulty: p.difficulty,
        topics: p.topics,
        companies: p.companies,
        otherTags: p.otherTags,
        groups: p.groups
      })),
      facets: computeFacets(sortedItems, company),
      companyLogos
    };

    return {
      params: { slug: slugify(company) },
      props: { 
        company, 
        problems: sortedItems,
        logoUrl: companyLogos[company],
        filterData
      },
    };
  });
}

const { company, problems, logoUrl, filterData } = Astro.props;
---

<IndexLayout title={company} description={`${problems.length} problems asked at ${company}.`}>
  {logoUrl && (
    <div class="company-header-logo">
      <img src={logoUrl} alt={company} width="64" height="64" />
    </div>
  )}

  <FilterBar data={filterData} />
  <ProblemGroupList problems={problems} />
</IndexLayout>

<style>
  .company-header-logo {
    margin-bottom: var(--space-6);
  }
  
  .company-header-logo img {
    border-radius: var(--radius-md);
    background: white;
    padding: var(--space-1);
    box-shadow: var(--shadow-sm);
  }
</style>
