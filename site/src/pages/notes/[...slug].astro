---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../../layouts/NoteLayout.astro';
import { slugify } from '../../utils/content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(entry => {
    // entry.id might contain slashes if in subdirectories (e.g., 'Extras/Queue patterns and Variations')
    // We slugify each part to create a clean URL: /notes/extras/queue-patterns-and-variations
    const parts = entry.id.split('/');
    const slug = parts.map(slugify).join('/');
    
    let rawParts = [...parts];
    if (entry.filePath) {
      const normalizedPath = entry.filePath.replace(/\\/g, '/');
      const match = normalizedPath.match(/\/Notes\/(.+)$/);
      if (match) {
        rawParts = match[1].split('/').map(p => p.replace(/\.md$/, ''));
      }
    } else {
      rawParts[rawParts.length - 1] = rawParts[rawParts.length - 1].replace(/\.md$/, '');
    }
    
    return {
      params: { slug },
      props: { entry, parts: rawParts },
    };
  });
}

const { entry, parts } = Astro.props;
const { Content, headings } = await render(entry);

// Extract title from frontmatter or exact filename
const fileName = parts[parts.length - 1];
const title = entry.data?.Title || fileName;
const updated = entry.data?.updated ? String(entry.data.updated) : undefined;
---

<NoteLayout title={title} pathSegments={parts} headings={headings} updated={updated}>
  <Content />
</NoteLayout>
