---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../../layouts/NoteLayout.astro';
import { slugify } from '../../utils/content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(entry => {
    // entry.id might contain slashes if in subdirectories (e.g., 'Extras/Queue patterns and Variations')
    // We slugify each part to create a clean URL: /notes/extras/queue-patterns-and-variations
    const parts = entry.id.split('/');
    const slug = parts.map(slugify).join('/');
    
    return {
      params: { slug },
      props: { entry, parts },
    };
  });
}

const { entry, parts } = Astro.props;
const { Content } = await render(entry);

// Extract title from frontmatter or filename
const fileName = parts[parts.length - 1];
const title = entry.data?.Title || fileName.replace(/-/g, ' ');
---

<NoteLayout title={title} pathSegments={parts}>
  <Content />
</NoteLayout>
